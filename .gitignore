# === secrets & dados sensíveis (NUNCA versionar) ===
# .env e variantes → em produção viram GitHub Secrets / Key Vault / Doppler
.env
.env.*
!.env.example
*.pem
*.key
# Dados sensíveis / PII — never relax
data/
leads.json
*.leads.json
secrets/
# Lista lida pelo hook guarda-confidencialidade.py. Versioná-la anularia o
# propósito dela. Distribua por canal privado, nunca pelo repo.
.claude/nomes-confidenciais.txt
# Derivados regeneráveis
node_modules/
dist/
.next/
__pycache__/
# Planos de sessão (locais, por máquina — o plano vive fora do git; specs/NNN-nome/ é o versionado)
.claude/plans/
# Insumos brutos de sessão (páginas de livro, PDFs, prints que alimentam um resumo)
# e as referências derivadas deles: material de terceiro com direito autoral.
# Ficam locais na máquina — o repo é publicado por allowlist (ADR-0036) e resumo
# de obra alheia não atravessa esse gate.
.inputs/
.claude/refs/
# Arquivos de importação de tickets (saída do debito.py): derivados do DEBT.md e
# carregam o score calculado — versioná-los criaria a segunda fonte que a ADR-0020 proíbe.
docs/tickets/

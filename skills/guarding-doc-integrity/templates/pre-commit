#!/usr/bin/env bash
# Gate pré-commit do sdd-iuri: valida a integridade documental (deps.toml) quando o
# commit toca .md ou o próprio deps.toml. Instalado pelo bootstrap da skill
# guarding-doc-integrity (opt-in). O caminho do validador vem da config local do git
# (não versionada — portabilidade RNF5): git config sdd-iuri.validator <caminho>
set -u

staged=$(git diff --cached --name-only --diff-filter=ACMR)
echo "$staged" | grep -qE '\.md$|(^|/)deps\.toml$' || exit 0

validador=$(git config --get sdd-iuri.validator || true)
if [ -z "$validador" ] || [ ! -f "$validador" ]; then
  echo "pre-commit (sdd-iuri): validador não configurado ou ausente — pulando (configure: git config sdd-iuri.validator <caminho de validate_integrity.py>)" >&2
  exit 0
fi

if python3 "$validador" .; then
  exit 0
fi
echo "pre-commit: integridade documental FALHOU — corrija antes de commitar." >&2
echo "pre-commit: bypass consciente (registre o porquê): git commit --no-verify" >&2
exit 1
